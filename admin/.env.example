NEXT_PUBLIC_DOCTOR_PORTAL_URL=http://127.0.0.1:5175

# Patient registration portal for dashboard quick action
NEXT_PUBLIC_CUSTOMER_PORTAL_URL=http://127.0.0.1:5174
