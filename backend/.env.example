APP_ENV=development
PORT=5001
DATABASE_URL=
MIGRATION_DATABASE_URL=
JWT_SECRET_KEY=
OTP_HMAC_SECRET=
JWT_ISSUER=familycare-api
JWT_AUDIENCE=familycare-clients
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
RATELIMIT_STORAGE_URI=memory://
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3005,http://127.0.0.1:3005
COOKIE_SECURE=false
# Admin-triggered clinic location lookup only; no background/bulk geocoding.
# Public Nominatim: max 1 request/second app-wide, cached, with attribution.
# Personal doctor address is never sent to Nominatim (only its PIN to postal API).
CLINIC_GEOCODING_ENABLED=true
CLINIC_GEOCODER_URL=https://nominatim.openstreetmap.org/search
VERIFICATION_USER_AGENT=FamilyCareDoctorReview/1.0 (https://github.com/coreoutsourcingservices/family-care)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_ALLOW_INSECURE=false
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
CLOUDINARY_CLOUD_NAME=''
CLOUDINARY_API_KEY=''
CLOUDINARY_API_SECRET=''
